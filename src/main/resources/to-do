-- Add indexes for performance
CREATE INDEX idx_transfers_originalTransferId ON Transfers(originalTransferId);
CREATE INDEX idx_transfers_previousTransferId ON Transfers(previousTransferId);
CREATE INDEX idx_transfers_transferSequence ON Transfers(transferSequence);
CREATE INDEX idx_transfers_assetTag_sequence ON Transfers(assetTag, transferSequence);

-- Update existing transfers to set isInitialTransfer = true for each asset's first transfer
-- This assumes the first transfer is the one with the lowest transferId for each asset
WITH FirstTransfers AS (
    SELECT assetTag, MIN(transferId) as minTransferId
    FROM Transfers
    WHERE assetTag IS NOT NULL AND assetTag != ''
    GROUP BY assetTag
)
UPDATE Transfers
SET isInitialTransfer = 1, transferSequence = 1
WHERE transferId IN (SELECT minTransferId FROM FirstTransfers);

-- Update sequence numbers for existing transfers
-- This is a simplified version - you may need to adjust based on your data
WITH NumberedTransfers AS (
    SELECT
        transferId,
        assetTag,
        ROW_NUMBER() OVER (PARTITION BY assetTag ORDER BY transferDate ASC, transferId ASC) as seq
    FROM Transfers
    WHERE assetTag IS NOT NULL AND assetTag != ''
)
UPDATE Transfers
SET transferSequence = nt.seq
FROM Transfers t
INNER JOIN NumberedTransfers nt ON t.transferId = nt.transferId;

-- Set previousTransferId and originalTransferId for existing transfers
WITH TransferChains AS (
    SELECT
        transferId,
        assetTag,
        transferSequence,
        LAG(transferId, 1, NULL) OVER (PARTITION BY assetTag ORDER BY transferSequence) as prevId,
        FIRST_VALUE(transferId) OVER (PARTITION BY assetTag ORDER BY transferSequence) as firstId
    FROM Transfers
    WHERE assetTag IS NOT NULL AND assetTag != ''
)
UPDATE Transfers
SET
    previousTransferId = tc.prevId,
    originalTransferId = CASE WHEN tc.transferSequence = 1 THEN NULL ELSE tc.firstId END
FROM Transfers t
INNER JOIN TransferChains tc ON t.transferId = tc.transferId;











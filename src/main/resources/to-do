-- 1. CREATE DRIVER RATINGS TABLE
-- ============================================
IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[driver_ratings]') AND type in (N'U'))
BEGIN
    CREATE TABLE [dbo].[driver_ratings] (
        [rating_id] BIGINT IDENTITY(1,1) NOT NULL,
        [request_id] BIGINT NOT NULL,
        [driver_id] BIGINT NOT NULL,
        [user_id] BIGINT NOT NULL,
        [rating] INT NOT NULL,
        [feedback] NVARCHAR(MAX) NULL,
        [token] NVARCHAR(255) NULL,
        [created_at] DATETIME2 DEFAULT GETDATE() NOT NULL,
        CONSTRAINT PK_driver_ratings PRIMARY KEY ([rating_id])
    );
    PRINT '✅ Table driver_ratings created successfully';
END
ELSE
BEGIN
    PRINT 'ℹ️ Table driver_ratings already exists';
END
GO


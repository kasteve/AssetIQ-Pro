-- Step 3: Update existing bookings with room_type and room_name from rooms table
UPDATE b
SET
    b.room_type = r.room_type,
    b.room_name = r.room_name
FROM
    tbl_bookings b
    INNER JOIN tbl_rooms r ON b.room_id = r.room_id
WHERE
    b.room_type IS NULL
    OR b.room_name IS NULL;
GO

-- Step 4: Verify the update
SELECT TOP 10
    b.booking_id,
    b.room_id,
    b.room_name,
    b.room_type,
    r.room_name as room_name_from_rooms,
    r.room_type as room_type_from_rooms
FROM
    tbl_bookings b
    INNER JOIN tbl_rooms r ON b.room_id = r.room_id;

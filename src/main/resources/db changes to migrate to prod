-- ============================================================
CREATE TRIGGER trg_user_groups_update
ON user_groups
AFTER UPDATE
AS
BEGIN
    SET NOCOUNT ON;
    UPDATE user_groups
    SET updated_at = GETDATE()
    FROM user_groups ug
    INNER JOIN inserted i ON ug.group_id = i.group_id;
END;

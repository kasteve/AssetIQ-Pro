-- User Groups Table
CREATE TABLE user_groups (
    group_id BIGINT IDENTITY(1,1) PRIMARY KEY,
    group_name VARCHAR(100) NOT NULL UNIQUE,
    description VARCHAR(255) NULL,
    is_active BIT DEFAULT 1,
    is_system_group BIT DEFAULT 0,
    created_at DATETIME DEFAULT GETDATE(),
    updated_at DATETIME DEFAULT GETDATE(),
    created_by BIGINT NULL,
    updated_by BIGINT NULL
);
GO

-- User Group Members (Many-to-Many)
CREATE TABLE user_group_members (
    group_id BIGINT NOT NULL,
    user_id BIGINT NOT NULL,
    PRIMARY KEY (group_id, user_id),
    FOREIGN KEY (group_id) REFERENCES user_groups(group_id) ON DELETE CASCADE,
    FOREIGN KEY (user_id) REFERENCES app_users(user_id) ON DELETE CASCADE
);
GO

-- User Group Permissions (Many-to-Many)
CREATE TABLE user_group_permissions (
    group_id BIGINT NOT NULL,
    permission_id INT NOT NULL,
    PRIMARY KEY (group_id, permission_id),
    FOREIGN KEY (group_id) REFERENCES user_groups(group_id) ON DELETE CASCADE,
    FOREIGN KEY (permission_id) REFERENCES permissions(permission_id) ON DELETE CASCADE
);
GO

-- Role Permissions Table
CREATE TABLE role_permissions (
    role_permission_id BIGINT IDENTITY(1,1) PRIMARY KEY,
    role_name VARCHAR(50) NOT NULL,
    permission_name VARCHAR(100) NOT NULL,
    created_at DATETIME DEFAULT GETDATE(),
    created_by BIGINT NULL,
    CONSTRAINT uk_role_permission UNIQUE (role_name, permission_name)
);
GO


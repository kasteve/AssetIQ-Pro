-- ADMINS get all admin permissions
INSERT INTO user_group_permissions (group_id, permission_id)
SELECT
    (SELECT group_id FROM user_groups WHERE group_name = 'ADMINS'),
    p.permission_id
FROM permissions p
WHERE p.permission_name IN (
    'ADMIN', 'MANAGE_ROLES', 'CREATE_USERS', 'RESET_PASSWORDS',
    'MANAGE_CONFIG', 'VIEW_AUDIT', 'VIEW_ALL_TRANSACTIONS',
    'MANAGE_GROUPS', 'VIEW_GROUPS'
)
AND NOT EXISTS (
    SELECT 1 FROM user_group_permissions ugp
    WHERE ugp.group_id = (SELECT group_id FROM user_groups WHERE group_name = 'ADMINS')
    AND ugp.permission_id = p.permission_id
);
GO


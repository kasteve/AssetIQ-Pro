Get db schema
=======================================

SELECT
    table_schema,
    table_name,
    column_name,
    data_type,
    character_maximum_length
FROM
    INFORMATION_SCHEMA.COLUMNS
ORDER BY
    table_schema,
    table_name,
    ordinal_position;


=========================================

entire database schema with all structural mappings,
column details, primary keys, and foreign keys,

====================================================


SELECT
    obj.name AS Table_Name,
    col.name AS Column_Name,
    t.name AS Data_Type,
    CASE
        WHEN pk.column_id IS NOT NULL THEN 'PRIMARY KEY'
        WHEN fk.parent_column_id IS NOT NULL THEN 'FOREIGN KEY'
        ELSE 'COLUMN'
    END AS Key_Type,
    ref_obj.name AS Referenced_Table,
    ref_col.name AS Referenced_Column
FROM sys.tables obj
INNER JOIN sys.columns col ON obj.object_id = col.object_id
INNER JOIN sys.types t ON col.user_type_id = t.user_type_id
LEFT JOIN sys.index_columns pk
    ON obj.object_id = pk.object_id
    AND col.column_id = pk.column_id
    AND pk.index_id = 1 -- Clustered index (usually PK)
LEFT JOIN sys.foreign_key_columns fk
    ON obj.object_id = fk.parent_object_id
    AND col.column_id = fk.parent_column_id
LEFT JOIN sys.tables ref_obj ON fk.referenced_object_id = ref_obj.object_id
LEFT JOIN sys.columns ref_col
    ON fk.referenced_object_id = ref_col.object_id
    AND fk.referenced_column_id = ref_col.column_id
ORDER BY Table_Name, col.column_id;


